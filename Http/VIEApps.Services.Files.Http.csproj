<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFrameworks Condition="'$(TargetFramework)' != 'net5.0'">net8.0-windows</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFramework)' == 'net5.0'">net5.0</TargetFrameworks>
		<WarningLevel>3</WarningLevel>
		<NoWarn>1573,1591,IDE0054,CA1416,CA1822,NU1605</NoWarn>
		<OutputType>Exe</OutputType>
		<InvariantGlobalization>true</InvariantGlobalization>
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
		<RootNamespace>net.vieapps.Services.Files</RootNamespace>
		<StartupObject>net.vieapps.Services.Files.Startup</StartupObject>
		<AssemblyName>VIEApps.Services.Files.Http</AssemblyName>
		<AssemblyTitle>VIEApps NGX Files HTTP</AssemblyTitle>
		<Authors>VIEApps.net</Authors>
		<Company>VIEApps.net</Company>
		<Product>VIEApps NGX</Product>
		<Copyright>© $([System.DateTime]::Now.Year) VIEApps.net</Copyright>
		<AssemblyVersion>10.8$(ReleaseVersion)</AssemblyVersion>
		<FileVersion>10.8$(ReleaseVersion)</FileVersion>
		<InformationalVersion>10.8.$([System.DateTime]::Now.Year).$([System.DateTime]::Now.Month).$([System.DateTime]::Now.Day)@$(TargetFramework)#$(ReleaseRevision)</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Remove=".DS_Store" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Base.Libs\VIEApps.Services.Base.Libs.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ImageProcessorNet5.Plugins.WebP" Version="1.0.0" />
		<PackageReference Include="QRCoder" Version="1.5.1" />
		<PackageReference Include="System.Drawing.Common" Version="5.0.3" Condition="'$(TargetFramework)' == 'net5.0'" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.4" Condition="'$(TargetFramework)' != 'net5.0'" />
		<PackageReference Include="VIEApps.Components.Utility.AssemblyLoader" Version="10.8.2406.2" />
		<PackageReference Include="VIEApps.Services.Base.Http" Version="10.8.2406.4" />
	</ItemGroup>

</Project>